# Supabase PostgreSQL Database Configuration (Session Pooler, Port 5432, SSL required)
# Format: postgresql://[user].[project-ref]:[password]@[pooler-host]:5432/[database]?sslmode=require

# Administrative connection for Alembic migrations and database administration (postgres role)
DATABASE_ADMIN_URL=postgresql://postgres.your-project-ref:your-admin-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Restricted runtime role connection for application operations (hackpreneur_app role)
DATABASE_RUNTIME_URL=postgresql://hackpreneur_app.your-project-ref:your-runtime-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Active application connection (uses DATABASE_URL in FastAPI)
DATABASE_URL=postgresql://hackpreneur_app.your-project-ref:your-runtime-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth JWT Verification Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated frontend origins allowed by CORS. Never use wildcard origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
